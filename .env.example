# Configurações do Banco de Dados
# No Render ou Railway com PostgreSQL, a variável DATABASE_URL é fornecida automaticamente.
# Localmente (se vazio ou não definido), o sistema usará SQLite (health_hub.db).
DATABASE_URL=sqlite:///./health_hub.db

# Chave secreta para tokens JWT (Gere uma chave segura e aleatória em produção)
SECRET_KEY=sua_chave_secreta_super_segura_aqui_para_producao_12345

# Configurações da Evolution API (WhatsApp)
# Preencha quando conectar sua instância na nuvem
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
